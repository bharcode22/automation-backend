# Server Port & Host
PORT=5050
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGIN=*

# Default SSH Configuration for Target Server (e.g. POD / VPS)
SSH_DEFAULT_HOST=127.0.0.1
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USERNAME=pod
SSH_DEFAULT_AUTH_TYPE=password
SSH_DEFAULT_PASSWORD=
SSH_DEFAULT_KEY_PATH=
SSH_DEFAULT_PASSPHRASE=

# Timeout Settings (Milliseconds)
SSH_HANDSHAKE_TIMEOUT=15000
SSH_COMMAND_TIMEOUT=30000
