# Server Port & Host
PORT=5050
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated or * for all)
CORS_ORIGIN=*

# Default SSH Configuration for Target Server (e.g. POD / VPS)
# Permintaan API dapat menimpa (override) parameter ini di body request
SSH_DEFAULT_HOST=127.0.0.1
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USERNAME=pod
SSH_DEFAULT_AUTH_TYPE=password

# Opsi 1: Otentikasi Password
SSH_DEFAULT_PASSWORD=

# Opsi 2: Otentikasi Private Key (path ke file .pem/.id_rsa atau raw key string)
SSH_DEFAULT_KEY_PATH=~/.ssh/id_rsa
SSH_DEFAULT_PASSPHRASE=

# Timeout Settings (Milliseconds)
SSH_HANDSHAKE_TIMEOUT=15000
SSH_COMMAND_TIMEOUT=30000
